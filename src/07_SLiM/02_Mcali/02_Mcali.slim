// general late calls

1:20000 late() {

	if (size(sim.mutationsOfType(m1)) == 0){
    freq0 = rep(0,  COUNT);
	cat(freq0);
	state="lost";
	writeFile(
	paste(root, "/", "McaliclineAFs.",repId,"_", m,"_", thresh,"_", k,"_", mag,"_", N , "_", state, "_" , sim.cycle,
	"." , "txt", sep=""),
	paste(freq0),
	append=F);
	cat("mutation lost in cycle " + sim.cycle + "\n");
	
	sim.simulationFinished();			
			}//close if
			
	if (sim.cycle == 20000){
	
	 mut1 = sim.mutationsOfType(m1);
	 freq1=NULL;
	 for (p in sim.subpopulations)
    freq1 = c(freq1, sim.mutationFrequencies(p, mut1)); 
    catn(sim.subpopulations);
    catn(freq1);
	state="poly";
	
    writeFile(
	 paste(root, "/", "McaliclineAFs.",repId,"_", m,"_", thresh,"_", k,"_", mag,"_", N , "_", state, "_" , sim.cycle,
	 "." , "txt", sep=""),
	 paste(freq1),
	 append=F);
	
   }//close 2ndif

